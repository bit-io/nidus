#[test]
fn test_span_basic() is
    let s: nidus_span::Span = nidus_span::span(10, 5)
    assert_eq(s.end_offset(), 15)
    assert_true(s.contains(10))
    assert_true(s.contains(14))
    assert_true(!s.contains(15))
end

#[test]
fn test_line_col_conversion() is
    let src: string = "abc\ndef\nghi"
    assert_eq(nidus_text::line_of_offset(src, 0), 1)
    assert_eq(nidus_text::line_of_offset(src, 4), 2)
    assert_eq(nidus_text::line_of_offset(src, 8), 3)
    assert_eq(nidus_text::col_of_offset(src, 4), 1)
    assert_eq(nidus_text::col_of_offset(src, 6), 3)
    assert_eq(nidus_text::line_count(src), 3)
end

#[test]
fn test_get_line_text() is
    let src: string = "let x = 1\nlet y = 2\n"
    assert_eq(nidus_text::get_line_text(src, 1), "let x = 1")
    assert_eq(nidus_text::get_line_text(src, 2), "let y = 2")
end

#[test]
fn test_diagnostic_builder() is
    let mut d: nidus_diagnostic::Diagnostic = nidus_diagnostic::error("coś poszło nie tak")
    d = d.with_code("nidus::test::demo")
    d = d.with_help("spróbuj ponownie")
    d = d.with_label(nidus_span::primary_label(4, 3, "tutaj"))

    assert_eq(d.message, "coś poszło nie tak")
    assert_eq(d.code, "nidus::test::demo")
    assert_eq(d.help, "spróbuj ponownie")
    assert_eq(d.labels.len(), 1)
    assert_true(d.is_error())
end

#[test]
fn test_severity_constructors() is
    let w: nidus_diagnostic::Diagnostic = nidus_diagnostic::warning("uwaga")
    let a: nidus_diagnostic::Diagnostic = nidus_diagnostic::advice("porada")
    assert_true(!w.is_error())
    assert_true(!a.is_error())
    assert_eq(nidus_severity::index(w.severity), 1)
    assert_eq(nidus_severity::index(a.severity), 2)
end

#[test]
fn test_render_all_styles_nonempty() is
    let mut d: nidus_diagnostic::Diagnostic = nidus_diagnostic::error("dzielenie przez zero")
    d = d.with_code("nidus::eval::div_zero")
    d = d.with_source("main.ns", "let y = x / 0\n")
    d = d.with_label(nidus_span::primary_label(8, 5, "tu nie można dzielić przez zero"))
    d = d.with_help("sprawdź mianownik przed dzieleniem")

    let styles: [nidus_style::Style] = nidus_style::all()
    assert_eq(styles.len(), 7)
    for s in styles is
        let cfg: nidus_style::Config = nidus_style::config_with(s, nidus_theme::theme_mono())
        let out: string = nidus_report::render(d, cfg)
        assert_true(out.len() > 0)
    end
end

#[test]
fn test_json_escaping() is
    let d: nidus_diagnostic::Diagnostic = nidus_diagnostic::error("z \"cudzysłowem\" i\nnową linią")
    let out: string = nidus_machine::render_json(d)
