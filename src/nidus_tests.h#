#[test]
fn test_related_chain() is
    let cause: nidus_diagnostic::Diagnostic = nidus_diagnostic::error("plik nie istnieje").with_code("nidus::io::not_found")
    let mut root: nidus_diagnostic::Diagnostic = nidus_diagnostic::error("nie udało się wczytać konfiguracji")
    root = root.with_related(cause)

    assert_eq(root.related.len(), 1)
    assert_eq(root.related[0].code, "nidus::io::not_found")

    let out: string = nidus_report::render(root, nidus_style::config_with(nidus_style::narratable(), nidus_theme::theme_polski()))
    assert_true(out.contains("spowodowane przez"))
end

