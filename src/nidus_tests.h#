;; ── kolory (0.2.0) ────────────────────────────────────────────────────────

fn sample_diag() -> nidus_diagnostic::Diagnostic is
    let mut d: nidus_diagnostic::Diagnostic = nidus_diagnostic::error("nieznana zmienna `c`")
    d = d.with_code("nidus::resolve::unknown_ident")
    d = d.with_source("add.ns", "fn add(a: int, b: int) -> int is\n    return a + c\nend\n")
    d = d.with_label(nidus_span::primary_label(48, 1, "brak takiej zmiennej"))
    d = d.with_label(nidus_span::label(15, 1, "czy chodziło o `b`?"))
    d = d.with_help("sprawdź literówki w `nazwach`")
    d = d.with_url("https://example.com/e")
    return d
end

#[test]
fn test_colors_present_in_dark_theme() is
    let out: string = nidus_report::render(sample_diag(), nidus_style::config_with(nidus_style::graphical(), nidus_theme::theme_dark()))
    assert_true(out.contains("\x1b[1;91m"))   ;; kolor błędu
    assert_true(out.contains("\x1b[95m"))     ;; kod błędu / `backticki`
    assert_true(out.contains("\x1b[96m"))     ;; numer linii z etykietą
end

#[test]
fn test_mono_theme_has_no_escape_codes() is
    let styles: [nidus_style::Style] = [nidus_style::graphical(), nidus_style::ascii(), nidus_style::narratable(), nidus_style::minimal()]
    for st in styles is
        let out: string = nidus_report::render(sample_diag(), nidus_style::config_with(st, nidus_theme::theme_mono()))
        assert_true(!out.contains("\x1b"))
    end
end

#[test]
fn test_colors_do_not_change_layout() is
    ;; po zdjęciu sekwencji ANSI widok kolorowy == widok bez kolorów
    let colored: string = nidus_report::render(sample_diag(), nidus_style::config_with(nidus_style::graphical(), nidus_theme::theme_dark()))
    let plain:   string = nidus_report::render(sample_diag(), nidus_style::config_with(nidus_style::graphical(), nidus_theme::theme_mono_unicode()))
    assert_eq(fmt::strip_ansi(colored), plain)

    let colored_min: string = nidus_report::render(sample_diag(), nidus_style::config_with(nidus_style::minimal(), nidus_theme::theme_dark()))
    let plain_min:   string = nidus_report::render(sample_diag(), nidus_style::config_with(nidus_style::minimal(), nidus_theme::theme_mono()))
    assert_eq(fmt::strip_ansi(colored_min), plain_min)
end

#[test]
fn test_highlight_line() is
    let pal: nidus_theme::Palette = nidus_theme::palette_dark()
    let placed: [nidus_graphical::Placed] = [nidus_graphical::placed("x", true, 5, 8)]
    let out: string = nidus_graphical::highlight_line("abcdefghij", placed, pal.error_c, pal)
    assert_eq(fmt::strip_ansi(out), "abcdefghij")
    assert_true(out.contains(pal.error_c + "efg" + pal.reset))
    ;; bez kolorów — dokładnie ten sam tekst
    let mono: nidus_theme::Palette = nidus_theme::palette_mono()
    assert_eq(nidus_graphical::highlight_line("abcdefghij", placed, "", mono), "abcdefghij")
end

#[test]
fn test_colorize_ticks() is
    let pal: nidus_theme::Palette = nidus_theme::palette_dark()
    let out: string = nidus_theme::colorize_ticks("użyj `foo()` teraz", pal.code_c, "", pal)
    assert_eq(fmt::strip_ansi(out), "użyj `foo()` teraz")
    assert_true(out.contains(pal.code_c + "`foo()`" + pal.reset))
    ;; niedomknięty backtick zostaje bez zmian
    assert_eq(nidus_theme::colorize_ticks("a `b", pal.code_c, "", pal), "a `b")
    ;; mono — bez zmian
    assert_eq(nidus_theme::colorize_ticks("a `b` c", "", "", nidus_theme::palette_mono()), "a `b` c")
end

#[test]
fn test_ascii_style_uses_ascii_charset() is
    let out: string = nidus_report::render(sample_diag(), nidus_style::config_with(nidus_style::ascii(), nidus_theme::theme_mono_unicode()))
    assert_true(!out.contains("╭"))
    assert_true(!out.contains("│"))
end

#[test]
fn test_summarize_colored() is
    let ds: [nidus_diagnostic::Diagnostic] = [nidus_diagnostic::error("a"), nidus_diagnostic::warning("c")]
    let plain: string = nidus_report::summarize_colored(ds, nidus_theme::theme_mono())
    assert_eq(plain, nidus_report::summarize(ds))
    let col: string = nidus_report::summarize_colored(ds, nidus_theme::theme_dark())
    assert_eq(fmt::strip_ansi(col), nidus_report::summarize(ds))
    assert_true(col.contains("\x1b"))
end

#[test]
fn test_style_index_roundtrip() is
    let all: [nidus_style::Style] = nidus_style::all()
    let mut i: int = 0
    while i < all.len() is
        assert_eq(nidus_style::index(all[i]), i)
        i += 1
    end
    assert_eq(nidus_style::style_name(nidus_style::github_actions()), "github")
end

