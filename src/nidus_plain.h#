use "std -> strings" from "str"
use "std -> fmt"     from "fmt"

mod nidus_diagnostic
mod nidus_text
mod nidus_theme

pub fn render_narratable(d: nidus_diagnostic::Diagnostic, theme: nidus_theme::Theme) -> string is
    let w:   nidus_theme::Words   = theme.words
    let pal: nidus_theme::Palette = theme.palette
    let sev_color: string = nidus_theme::severity_color(d.severity, pal)
    let mut out: string = nidus_theme::paint(sev_color, nidus_text::capitalize(sev_word_for(d.severity, w)) + ":", pal) + " " + pal.bold_c + d.message + pal.reset + "\n"

    if d.code != "" is
        out = out + "    " + nidus_theme::paint(pal.dim_c, "Kod:", pal) + " " + nidus_theme::paint(pal.code_c, d.code, pal) + "\n"
    end
    out = out + "    " + nidus_theme::paint(pal.dim_c, "Poziom:", pal) + " " + nidus_theme::paint(sev_color, nidus_theme::sev_word_for(d.severity, w), pal) + "\n"

    if d.source_code != "" is
        for l in d.labels is
            let ln:   int    = nidus_text::line_of_offset(d.source_code, l.sp.offset)
            let col:  int    = nidus_text::col_of_offset(d.source_code, l.sp.offset)
            let text: string = nidus_text::get_line_text(d.source_code, ln)
            out = out + "    " + nidus_theme::paint(pal.dim_c, "Linia", pal) + " " + nidus_theme::paint(pal.pos_c, to_string(ln), pal) + nidus_theme::paint(pal.dim_c, ", kolumna", pal) + " " + nidus_theme::paint(pal.pos_c, to_string(col), pal)
            if d.source_name != "" is out = out + " (" + nidus_theme::paint(pal.path_c, d.source_name, pal) + ")" end
            out = out + ":\n"
            out = out + "        " + str::trim(text) + "\n"
            if l.text != "" is
                out = out + "        " + nidus_theme::paint(label_color(l.primary, sev_color, pal), "Etykieta:", pal) + " " + l.text + "\n"
            end
        end
    end

    if d.help != "" is out = out + nidus_theme::paint(pal.help_c, w.help + ":", pal) + " " + d.help + "\n" end
    if d.note != "" is out = out + nidus_theme::paint(pal.note_c, w.note + ":", pal) + " " + d.note + "\n" end
    if d.url  != "" is out = out + nidus_theme::paint(pal.note_c, w.see  + ":", pal) + " " + nidus_theme::paint(pal.link_c, d.url, pal) + "\n" end

    if d.related.len() > 0 is
        for r in d.related is
            out = out + nidus_theme::paint(pal.dim_c, w.caused_by + ":", pal) + "\n" + fmt::indent(render_narratable(r, theme), 4) + "\n"
        end
    end

    return out
end

pub fn loc_prefix(d: nidus_diagnostic::Diagnostic, line_no: int, col: int, pal: nidus_theme::Palette) -> string is
    if d.source_name != "" is
        return nidus_theme::paint(pal.path_c, d.source_name, pal) + nidus_theme::paint(pal.border_c, ":", pal) +
               nidus_theme::paint(pal.pos_c, to_string(line_no) + ":" + to_string(col), pal)
    end
    return nidus_theme::paint(pal.path_c, "nidus", pal)
end

pub fn render_minimal(d: nidus_diagnostic::Diagnostic, theme: nidus_theme::Theme) -> string is
    let w:   nidus_theme::Words   = theme.words
    let pal: nidus_theme::Palette = theme.palette
    let sev_color: string = nidus_theme::severity_color(d.severity, pal)
    let sev_word:  string = nidus_theme::paint(sev_color, nidus_theme::sev_word_for(d.severity, w), pal)
    let msg:       string = pal.bold_c + nidus_theme::colorize_ticks(d.message, pal.code_c, pal.bold_c, pal) + pal.reset
    let code_suffix: string = if d.code != "" is " " + nidus_theme::paint(pal.border_c, "[", pal) + nidus_theme::paint(pal.code_c, d.code, pal) + nidus_theme::paint(pal.border_c, "]", pal) else is "" end

    let mut out: string = ""
    if d.source_code != "" && d.labels.len() > 0 is
        for l in d.labels is
            let ln:     int    = nidus_text::line_of_offset(d.source_code, l.sp.offset)
            let col:    int    = nidus_text::col_of_offset(d.source_code, l.sp.offset)
            let prefix: string = loc_prefix(d, ln, col, pal)
            if l.text != "" is
                out = out + prefix + ": " + sev_word + ": " + msg + " " + nidus_theme::paint(label_color(l.primary, sev_color, pal), "-- " + l.text, pal) + code_suffix + "\n"
            else is
                out = out + prefix + ": " + sev_word + ": " + msg + code_suffix + "\n"
            end
        end
    else is
        let prefix: string = if d.source_name != "" is nidus_theme::paint(pal.path_c, d.source_name, pal) else is nidus_theme::paint(pal.path_c, "nidus", pal) end
        out = out + prefix + ": " + sev_word + ": " + msg + code_suffix + "\n"
    end

    if d.help != "" is out = out + "  " + nidus_theme::paint(pal.help_c, w.help + ":", pal) + " " + d.help + "\n" end
    if d.note != "" is out = out + "  " + nidus_theme::paint(pal.note_c, w.note + ":", pal) + " " + d.note + "\n" end
    if d.url  != "" is out = out + "  " + nidus_theme::paint(pal.note_c, w.see  + ":", pal) + " " + nidus_theme::paint(pal.link_c, d.url, pal) + "\n" end

    for r in d.related is
        out = out + render_minimal(r, theme)
    end
    return out
end
