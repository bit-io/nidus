pub let VERSION: string = "0.2.0"

pub fn about() -> string is
    return "nidus v" + VERSION + " -- rozbudowana biblioteka diagnostyczna dla H#, inspirowana miette"
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 1. SEVERITY — poziom istotności diagnostyki
;; ═══════════════════════════════════════════════════════════════════════════

enum Severity is
    Error
    Warning
    Advice
end

;; Stałe angielskie słowa (stabilne, używane w JSON / GitHub Actions —
;; formaty maszynowe/parsowalne, które NIE powinny być lokalizowane).
pub fn severity_word_en(sev: Severity) -> string is
    return match sev is
        Severity::Error   => "error"
        Severity::Warning => "warning"
        Severity::Advice  => "advice"
    end
end

fn sev_word_for(sev: Severity, w: Words) -> string is
    return match sev is
        Severity::Error   => w.error
        Severity::Warning => w.warning
        Severity::Advice  => w.advice
    end
end

fn severity_color(sev: Severity, pal: Palette) -> string is
    return match sev is
        Severity::Error   => pal.error_c
        Severity::Warning => pal.warning_c
        Severity::Advice  => pal.advice_c
    end
end

fn severity_icon(sev: Severity, cs: Charset) -> string is
    return match sev is
        Severity::Error   => cs.icon_error
        Severity::Warning => cs.icon_warning
        Severity::Advice  => cs.icon_advice
    end
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 2. SPAN i LABEL — zakresy bajtowe wskazujące fragmenty kodu źródłowego
;; ═══════════════════════════════════════════════════════════════════════════

struct Span is
    pub offset: int   ;; przesunięcie bajtowe od początku źródła (0-based)
    pub len:    int   ;; długość zakresu w bajtach (minimum efektywnie 1)
end

pub fn span(offset: int, len: int) -> Span is
    return Span { offset: offset, len: len }
end

;; Zakres wskazujący pojedynczy punkt (np. brakujący znak).
pub fn point(offset: int) -> Span is
    return Span { offset: offset, len: 1 }
end

impl Span is
    fn end_offset(self) -> int is
        return self.offset + self.len
    end

    fn contains(self, o: int) -> bool is
        return o >= self.offset && o < self.offset + self.len
    end
end

;; Etykieta — pojedyncze podświetlenie fragmentu kodu z opcjonalnym opisem.
;; `primary`  = true  -> główna etykieta (kolor błędu, pogrubiona)
;; `primary`  = false -> etykieta pomocnicza (kolor przygaszony)
struct Label is
    pub sp:      Span
    pub text:    string
    pub primary: bool
end

pub fn label(offset: int, len: int, text: string) -> Label is
    return Label { sp: span(offset, len), text: text, primary: false }
end

pub fn label_at(offset: int, text: string) -> Label is
    return Label { sp: point(offset), text: text, primary: false }
end

pub fn primary_label(offset: int, len: int, text: string) -> Label is
    return Label { sp: span(offset, len), text: text, primary: true }
end

pub fn primary_label_at(offset: int, text: string) -> Label is
    return Label { sp: point(offset), text: text, primary: true }
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 3. DIAGNOSTIC — rdzeń biblioteki: opis pojedynczego zgłoszenia
;; ═══════════════════════════════════════════════════════════════════════════

struct Diagnostic is
    pub message:     string
    pub code:        string       ;; np. "nidus::eval::div_zero" ("" jeśli brak)
    pub severity:    Severity
    pub help:        string       ;; sugestia naprawy ("" jeśli brak)
    pub note:        string       ;; dodatkowy kontekst ("" jeśli brak)
    pub url:         string       ;; link do dokumentacji ("" jeśli brak)
    pub labels:      [Label]      ;; podświetlenia we fragmencie źródła
    pub source_name: string       ;; nazwa pliku wyświetlana w nagłówku
    pub source_code: string       ;; pełna treść źródła ("" -> brak fragmentu)
    pub related:     [Diagnostic] ;; łańcuch powiązanych/przyczynowych błędów
end

fn empty_diagnostic(message: string) -> Diagnostic is
    return Diagnostic {
        message: message, code: "", severity: Severity::Error,
        help: "", note: "", url: "", labels: [],
        source_name: "", source_code: "", related: []
    }
end

;; ── Konstruktory ─────────────────────────────────────────────────────────
pub fn diagnostic(message: string) -> Diagnostic is
    return empty_diagnostic(message)
end

pub fn error(message: string) -> Diagnostic is
    return empty_diagnostic(message)
end

pub fn warning(message: string) -> Diagnostic is
    let mut d: Diagnostic = empty_diagnostic(message)
    d.severity = Severity::Warning
    return d
end

pub fn advice(message: string) -> Diagnostic is
    let mut d: Diagnostic = empty_diagnostic(message)
    d.severity = Severity::Advice
    return d
end

;; ── Budowniczy (fluent builder) ──────────────────────────────────────────
impl Diagnostic is
    fn with_code(self, code: string) -> Diagnostic is
        self.code = code
        return self
    end

    fn with_severity(self, sev: Severity) -> Diagnostic is
        self.severity = sev
        return self
    end

    fn as_error(self) -> Diagnostic is
        self.severity = Severity::Error
        return self
    end

    fn as_warning(self) -> Diagnostic is
        self.severity = Severity::Warning
        return self
    end

    fn as_advice(self) -> Diagnostic is
        self.severity = Severity::Advice
        return self
    end

    fn with_help(self, help_text: string) -> Diagnostic is
        self.help = help_text
        return self
    end

    fn with_note(self, note_text: string) -> Diagnostic is
        self.note = note_text
        return self
    end

    fn with_url(self, url_text: string) -> Diagnostic is
        self.url = url_text
        return self
    end

    fn with_source(self, name: string, code: string) -> Diagnostic is
        self.source_name = name
        self.source_code = code
        return self
    end

    fn with_label(self, l: Label) -> Diagnostic is
        self.labels.push(l)
        return self
    end

    fn with_related(self, other: Diagnostic) -> Diagnostic is
        self.related.push(other)
        return self
    end

    fn is_error(self) -> bool is
        return match self.severity is
            Severity::Error   => true
            Severity::Warning => false
            Severity::Advice  => false
        end
    end
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 4. NARZĘDZIA LINIA/KOLUMNA — konwersja offsetów bajtowych źródła
;;
;;    UWAGA: podobnie jak reszta łańcucha znaków w H#, operacje poniżej
;;    działają na jednostkach bajtowych (tak jak `s[i..i+1]` w std/strings.h#).
;;    Dla źródeł czysto ASCII kolumny są dokładne; dla wielobajtowego UTF-8
;;    w kodzie źródłowym pod diagnostyką kolumny mogą się przesunąć — to
;;    ograniczenie samego modelu stringów H#, nie tej biblioteki.
;; ═══════════════════════════════════════════════════════════════════════════

fn clamp_offset(offset: int, n: int) -> int is
    if offset < 0 is return 0 end
    if offset > n is return n end
    return offset
end

pub fn line_count(src: string) -> int is
    let n: int = src.len()
    let mut lines: int = 1
    let mut i: int = 0
    while i < n is
        if src[i..i + 1] == "\n" is
            lines += 1
        end
        i += 1
    end
    return lines
end

pub fn line_of_offset(src: string, offset: int) -> int is
    let n: int = src.len()
    let clamped: int = clamp_offset(offset, n)
    let mut line: int = 1
    let mut i: int = 0
    while i < clamped is
        if src[i..i + 1] == "\n" is
            line += 1
        end
        i += 1
    end
    return line
end

pub fn col_of_offset(src: string, offset: int) -> int is
    let n: int = src.len()
    let clamped: int = clamp_offset(offset, n)
    let mut col: int = 1
    let mut i: int = clamped
    while i > 0 is
        i -= 1
        if src[i..i + 1] == "\n" is
            return col
        end
        col += 1
    end
    return col
end

fn strip_cr(s: string) -> string is
    let n: int = s.len()
    if n > 0 && s[n - 1..n] == "\r" is
        return s[0..n - 1]
    end
    return s
end

;; Zwraca treść pojedynczej linii (1-based, bez \n / \r).
;; Nieistniejący numer linii zwraca "".
pub fn get_line_text(src: string, line_no: int) -> string is
    let n: int = src.len()
    let mut current: int = 1
    let mut start: int = 0
    let mut i: int = 0
    while i <= n is
        if i == n || src[i..i + 1] == "\n" is
            if current == line_no is
                return strip_cr(src[start..i])
            end
            current += 1
            start = i + 1
        end
        i += 1
    end
    return ""
end

