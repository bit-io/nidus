fn capitalize(s: string) -> string is
    if s.len() == 0 is return s end
    return str::to_upper(s[0..1]) + s[1..s.len()]
end

;; Owija tekst kolorem (nic nie robi, gdy kolor pusty — motywy mono).
fn paint(color: string, text: string, pal: Palette) -> string is
    if color == "" is return text end
    return color + text + pal.reset
end

;; Koloruje fragmenty w `backtickach` (razem z backtickami). Po zamknięciu
;; fragmentu przywraca styl `after` (np. pogrubienie wiadomości).
;; Niedomknięty backtick -> tekst bez zmian.
fn colorize_ticks(text: string, color: string, after: string, pal: Palette) -> string is
    if color == "" is return text end
    let parts: [string] = str::split(text, "`")
    if parts.len() % 2 == 0 is return text end
    let mut out: string = ""
    let mut i: int = 0
    while i < parts.len() is
        if i % 2 == 1 is
            out = out + color + "`" + parts[i] + "`" + pal.reset + after
        else is
            out = out + parts[i]
        end
        i += 1
    end
    return out
end

;; Zawija `text` do `width` znaków, dokleja `prefix` do pierwszej linii
;; i `cont_indent` do kolejnych (przydatne dla "  help: ..." / "  note: ...").
fn wrap_with_prefix(text: string, prefix: string, cont_indent: string, width: int) -> string is
    let mut avail: int = width - cont_indent.len()
    if avail < 20 is avail = 20 end
    let wrapped: string  = fmt::wrap(text, avail)
    let lines:   [string] = str::split(wrapped, "\n")
    let mut out: string = ""
    let mut i: int = 0
    while i < lines.len() is
        if i == 0 is
            out = out + prefix + lines[i]
        else is
            out = out + "\n" + cont_indent + lines[i]
        end
        i += 1
    end
    return out
end

;; Odmiana polskich rzeczowników w liczbie mnogiej (1 / 2-4 / 5+).
fn pluralize(n: int, one: string, few: string, many: string) -> string is
    let mod10:  int = n % 10
    let mod100: int = n % 100
    if n == 1 is return one end
    if mod10 >= 2 && mod10 <= 4 && !(mod100 >= 12 && mod100 <= 14) is return few end
    return many
end

fn json_escape(s: string) -> string is
    let n: int = s.len()
    let mut out: string = ""
    let mut i: int = 0
    while i < n is
        let c: string = s[i..i + 1]
        if c == "\"" is
            out = out + "\\\""
        elsif c == "\\" is
            out = out + "\\\\"
        elsif c == "\n" is
            out = out + "\\n"
        elsif c == "\r" is
            out = out + "\\r"
        elsif c == "\t" is
            out = out + "\\t"
        else is
            out = out + c
        end
        i += 1
    end
    return out
end

;; Ucieczka danych zgodnie z formatem GitHub Actions workflow-command
;; (kolejność ma znaczenie: `%` musi być zamienione jako pierwsze).
fn gh_escape(s: string) -> string is
    let s1: string = str::replace_all(s, "%", "%25")
    let s2: string = str::replace_all(s1, "\r", "%0D")
    let s3: string = str::replace_all(s2, "\n", "%0A")
    return s3
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 8. STYL "GRAPHICAL" / "ASCII" — pełny, graficzny widok fragmentu kodu
;; ═══════════════════════════════════════════════════════════════════════════

;; Etykieta z wyliczoną kolumną startu/końca w obrębie jednej linii.
struct Placed is
    pub text:      string
    pub primary:   bool
    pub col_start: int
    pub col_end:   int   ;; wyłącznie (exclusive)
end

fn sort_placed(arr: [Placed]) -> [Placed] is
    let mut a: [Placed] = arr
    let n: int = a.len()
    let mut i: int = 1
    while i < n is
        let key: Placed = a[i]
        let mut j: int = i - 1
        while j >= 0 && a[j].col_start > key.col_start is
            a[j + 1] = a[j]
            j -= 1
        end
        a[j + 1] = key
        i += 1
    end
    return a
end

fn labels_for_line(src: string, labels: [Label], line_no: int, line_len: int) -> [Placed] is
    let mut result: [Placed] = []
    for l in labels is
        let ln: int = line_of_offset(src, l.sp.offset)
        if ln == line_no is
            let col: int = col_of_offset(src, l.sp.offset)
            let mut seg_len: int = l.sp.len
            if seg_len < 1 is seg_len = 1 end
            let max_len: int = line_len - (col - 1)
            if max_len < 1 is
                seg_len = 1
            elsif seg_len > max_len is
                seg_len = max_len
            end
            result.push(Placed { text: l.text, primary: l.primary, col_start: col, col_end: col + seg_len })
        end
    end
    return sort_placed(result)
end

fn label_color(primary: bool, sev_color: string, pal: Palette) -> string is
    if primary is return sev_color end
    return pal.secondary_c
end

;; Linia kodu z podświetlonymi (kolorem etykiety) fragmentami wskazanymi
;; przez etykiety — dzięki temu błędne miejsce widać już w samym kodzie.
;; Bez kolorów zwraca dokładnie `text`.
fn highlight_line(text: string, placed: [Placed], sev_color: string, pal: Palette) -> string is
    let n: int = text.len()
    let mut out: string = ""
    let mut cursor: int = 1
    for p in placed is
        let mut a: int = p.col_start
        if a < cursor is a = cursor end
        let mut b: int = p.col_end
        if b > n + 1 is b = n + 1 end
        if a <= n && b > a is
            if a > cursor is out = out + text[cursor - 1..a - 1] end
            out = out + paint(label_color(p.primary, sev_color, pal), text[a - 1..b - 1], pal)
            cursor = b
        end
    end
    if cursor <= n is out = out + text[cursor - 1..n] end
    return out
end

fn render_snippet(d: Diagnostic, theme: Theme) -> string is
    let src: string   = d.source_code
    let cs:  Charset  = theme.charset
    let pal: Palette  = theme.palette
    let sev_color: string = severity_color(d.severity, pal)
    let total_lines: int  = line_count(src)

    let mut touched: [int] = []
    for l in d.labels is
        touched.push(line_of_offset(src, l.sp.offset))
    end
    if touched.len() == 0 is return "" end

    let mut min_line: int = touched[0]
    let mut max_line: int = touched[0]
    for t in touched is
        if t < min_line is min_line = t end
        if t > max_line is max_line = t end
    end
    min_line = min_line - theme.context_lines
    max_line = max_line + theme.context_lines
    if min_line < 1 is min_line = 1 end
    if max_line > total_lines is max_line = total_lines end

    let mut gw: int = to_string(max_line).len()
    if gw < 2 is gw = 2 end

    let head_line: int = line_of_offset(src, d.labels[0].sp.offset)
    let head_col:  int = col_of_offset(src, d.labels[0].sp.offset)

    ;; przerywana pionowa kreska w gutterze oraz kropka w wierszach adnotacji
    let gutter_dot: string = fmt::repeat(" ", gw + 1) + paint(pal.border_c, cs.dot, pal) + " "

    ;; ╭──[plik:linia:kolumna]
    let mut out: string = fmt::repeat(" ", gw + 1) + paint(pal.border_c, cs.top_left + cs.h_bar + cs.h_bar + "[", pal)
    if d.source_name != "" is
        out = out + paint(pal.path_c, d.source_name, pal) + paint(pal.border_c, ":", pal)
    end
    out = out + paint(pal.pos_c, to_string(head_line) + ":" + to_string(head_col), pal)
    out = out + paint(pal.border_c, "]", pal) + "\n"

    let mut line_no: int = min_line
    while line_no <= max_line is
        let text: string = get_line_text(src, line_no)
        let placed: [Placed] = labels_for_line(src, d.labels, line_no, text.len())

        ;; numer linii: wyraźny dla linii z etykietami, przygaszony dla kontekstu
        let mut num_color: string = pal.border_c
        let mut shown: string = text
        if placed.len() > 0 is
            num_color = pal.lineno_c
            shown = highlight_line(text, placed, sev_color, pal)
        end

        if theme.show_line_numbers is
            out = out + paint(num_color, fmt::pad_left(to_string(line_no), gw), pal) + " " + paint(pal.border_c, cs.v_bar, pal) + " " + shown + "\n"
        else is
            out = out + fmt::repeat(" ", gw) + " " + paint(pal.border_c, cs.v_bar, pal) + " " + shown + "\n"
        end

        if placed.len() > 0 is
            ;; wiersz podkreśleń
            let mut underline: string = gutter_dot
            let mut cursor: int = 1
            for p in placed is
                if p.col_start > cursor is
                    underline = underline + fmt::repeat(" ", p.col_start - cursor)
                    cursor = p.col_start
                end
                let seg_len: int = p.col_end - p.col_start
                let color:   string = label_color(p.primary, sev_color, pal)
                underline = underline + paint(color, fmt::repeat(cs.underline, seg_len), pal)
                cursor = p.col_end
            end
            out = out + underline + "\n"

            ;; wiersze komunikatów (efekt schodkowy), od najbardziej wysuniętej
            ;; w prawo etykiety do najbardziej wysuniętej w lewo
            let mut idx: int = placed.len() - 1
            while idx >= 0 is
                let p: Placed = placed[idx]
                if p.text != "" is
                    let mut row: string = gutter_dot
                    let mut c2: int = 1
                    let mut j: int = 0
                    while j < idx is
                        let other: Placed = placed[j]
                        if other.text != "" is
                            if other.col_start > c2 is
                                row = row + fmt::repeat(" ", other.col_start - c2)
                                c2 = other.col_start
                            end
                            row = row + paint(label_color(other.primary, sev_color, pal), cs.vbar_connector, pal)
                            c2 = c2 + 1
                        end
                        j += 1
                    end
                    if p.col_start > c2 is
                        row = row + fmt::repeat(" ", p.col_start - c2)
                    end
                    row = row + paint(label_color(p.primary, sev_color, pal), cs.connector + " " + p.text, pal)
                    out = out + row + "\n"
                end
                idx = idx - 1
            end
        end

        line_no = line_no + 1
    end

    out = out + fmt::repeat(" ", gw + 1) + paint(pal.border_c, cs.bottom_left + fmt::repeat(cs.h_bar, 4), pal) + "\n"
    return out
end

fn render_graphical(d: Diagnostic, theme: Theme) -> string is
    let pal: Palette = theme.palette
    let cs:  Charset = theme.charset
    let w:   Words   = theme.words
    let sev_color: string = severity_color(d.severity, pal)
    let icon:      string = severity_icon(d.severity, cs)
    let sev_word:  string = sev_word_for(d.severity, w)

    ;;   × error[kod::bledu]: wiadomość z `fragmentem`
    let mut out: string = "\n  " + paint(sev_color, icon + " " + sev_word, pal)
    if d.code != "" is
        out = out + paint(pal.border_c, "[", pal) + paint(pal.code_c, d.code, pal) + paint(pal.border_c, "]", pal)
    end
    out = out + paint(sev_color, ":", pal) + " "
    out = out + pal.bold_c + colorize_ticks(d.message, pal.code_c, pal.bold_c, pal) + pal.reset + "\n"

    if d.source_code != "" && d.labels.len() > 0 is
        out = out + render_snippet(d, theme) + "\n"
    elsif d.labels.len() > 0 is
        for l in d.labels is
            out = out + "    " + paint(label_color(l.primary, sev_color, pal), "->", pal) + " " + colorize_ticks(l.text, pal.code_c, "", pal) + "\n"
        end
        out = out + "\n"
    end

    if d.help != "" is
        let hp: string = "  " + paint(pal.help_c, w.help + ":", pal) + " "
        out = out + colorize_ticks(wrap_with_prefix(d.help, hp, "        ", theme.wrap_width), pal.code_c, "", pal) + "\n"
    end
    if d.note != "" is
        let np: string = "  " + paint(pal.note_c, w.note + ":", pal) + " "
        out = out + colorize_ticks(wrap_with_prefix(d.note, np, "        ", theme.wrap_width), pal.code_c, "", pal) + "\n"
    end
    if d.url != "" is
        out = out + "   " + paint(pal.note_c, w.see + ":", pal) + " " + paint(pal.link_c, d.url, pal) + "\n"
    end

    if d.related.len() > 0 is
        out = out + "  " + paint(pal.border_c, cs.connector, pal) + " " + paint(pal.dim_c, w.caused_by + ":", pal) + "\n"
        for r in d.related is
            out = out + fmt::indent(render_graphical(r, theme), 4) + "\n"
        end
    end

    return out
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 9. STYL "NARRATABLE" — opis liniowy, przyjazny czytnikom ekranu
;; ═══════════════════════════════════════════════════════════════════════════

fn render_narratable(d: Diagnostic, theme: Theme) -> string is
    let w:   Words   = theme.words
    let pal: Palette = theme.palette
    let sev_color: string = severity_color(d.severity, pal)
    let mut out: string = paint(sev_color, capitalize(sev_word_for(d.severity, w)) + ":", pal) + " " + pal.bold_c + d.message + pal.reset + "\n"

    if d.code != "" is
        out = out + "    " + paint(pal.dim_c, "Kod:", pal) + " " + paint(pal.code_c, d.code, pal) + "\n"
    end
    out = out + "    " + paint(pal.dim_c, "Poziom:", pal) + " " + paint(sev_color, sev_word_for(d.severity, w), pal) + "\n"

    if d.source_code != "" is
        for l in d.labels is
            let ln:   int    = line_of_offset(d.source_code, l.sp.offset)
            let col:  int    = col_of_offset(d.source_code, l.sp.offset)
            let text: string = get_line_text(d.source_code, ln)
            out = out + "    " + paint(pal.dim_c, "Linia", pal) + " " + paint(pal.pos_c, to_string(ln), pal) + paint(pal.dim_c, ", kolumna", pal) + " " + paint(pal.pos_c, to_string(col), pal)
            if d.source_name != "" is out = out + " (" + paint(pal.path_c, d.source_name, pal) + ")" end
            out = out + ":\n"
            out = out + "        " + str::trim(text) + "\n"
            if l.text != "" is
                out = out + "        " + paint(label_color(l.primary, sev_color, pal), "Etykieta:", pal) + " " + l.text + "\n"
            end
        end
    end

    if d.help != "" is out = out + paint(pal.help_c, w.help + ":", pal) + " " + d.help + "\n" end
    if d.note != "" is out = out + paint(pal.note_c, w.note + ":", pal) + " " + d.note + "\n" end
    if d.url  != "" is out = out + paint(pal.note_c, w.see  + ":", pal) + " " + paint(pal.link_c, d.url, pal) + "\n" end

    if d.related.len() > 0 is
        for r in d.related is
            out = out + paint(pal.dim_c, w.caused_by + ":", pal) + "\n" + fmt::indent(render_narratable(r, theme), 4) + "\n"
        end
    end

    return out
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 10. STYL "MINIMAL" — jedna linia na wpis, jak komunikaty kompilatora
;; ═══════════════════════════════════════════════════════════════════════════

fn loc_prefix(d: Diagnostic, line_no: int, col: int, pal: Palette) -> string is
    if d.source_name != "" is
        return paint(pal.path_c, d.source_name, pal) + paint(pal.border_c, ":", pal) +
               paint(pal.pos_c, to_string(line_no) + ":" + to_string(col), pal)
    end
    return paint(pal.path_c, "nidus", pal)
end

fn render_minimal(d: Diagnostic, theme: Theme) -> string is
    let w:   Words   = theme.words
    let pal: Palette = theme.palette
    let sev_color: string = severity_color(d.severity, pal)
    let sev_word:  string = paint(sev_color, sev_word_for(d.severity, w), pal)
    let msg:       string = pal.bold_c + colorize_ticks(d.message, pal.code_c, pal.bold_c, pal) + pal.reset
    let code_suffix: string = if d.code != "" is " " + paint(pal.border_c, "[", pal) + paint(pal.code_c, d.code, pal) + paint(pal.border_c, "]", pal) else is "" end

    let mut out: string = ""
    if d.source_code != "" && d.labels.len() > 0 is
        for l in d.labels is
            let ln:     int    = line_of_offset(d.source_code, l.sp.offset)
            let col:    int    = col_of_offset(d.source_code, l.sp.offset)
            let prefix: string = loc_prefix(d, ln, col, pal)
            if l.text != "" is
                out = out + prefix + ": " + sev_word + ": " + msg + " " + paint(label_color(l.primary, sev_color, pal), "-- " + l.text, pal) + code_suffix + "\n"
            else is
                out = out + prefix + ": " + sev_word + ": " + msg + code_suffix + "\n"
            end
        end
    else is
        let prefix: string = if d.source_name != "" is paint(pal.path_c, d.source_name, pal) else is paint(pal.path_c, "nidus", pal) end
        out = out + prefix + ": " + sev_word + ": " + msg + code_suffix + "\n"
    end

    if d.help != "" is out = out + "  " + paint(pal.help_c, w.help + ":", pal) + " " + d.help + "\n" end
    if d.note != "" is out = out + "  " + paint(pal.note_c, w.note + ":", pal) + " " + d.note + "\n" end
    if d.url  != "" is out = out + "  " + paint(pal.note_c, w.see  + ":", pal) + " " + paint(pal.link_c, d.url, pal) + "\n" end

    for r in d.related is
        out = out + render_minimal(r, theme)
    end
    return out
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 11. STYL "JSON" — wyjście maszynowe, stabilne pola (zawsze po angielsku)
;; ═══════════════════════════════════════════════════════════════════════════

fn render_json(d: Diagnostic) -> string is
    let mut out: string = "{"
    out = out + "\"severity\":\"" + severity_word_en(d.severity) + "\","
    out = out + "\"code\":\""     + json_escape(d.code)          + "\","
    out = out + "\"message\":\""  + json_escape(d.message)       + "\","
    out = out + "\"help\":\""     + json_escape(d.help)          + "\","
    out = out + "\"note\":\""     + json_escape(d.note)          + "\","
    out = out + "\"url\":\""      + json_escape(d.url)           + "\","
    out = out + "\"source_name\":\"" + json_escape(d.source_name) + "\","

    out = out + "\"labels\":["
    let mut i: int = 0
    while i < d.labels.len() is
        let l: Label = d.labels[i]
        out = out + "{"
        out = out + "\"offset\":"  + to_string(l.sp.offset) + ","
        out = out + "\"length\":"  + to_string(l.sp.len)    + ","
        out = out + "\"primary\":" + to_string(l.primary)   + ","
        if d.source_code != "" is
            out = out + "\"line\":"   + to_string(line_of_offset(d.source_code, l.sp.offset)) + ","
            out = out + "\"column\":" + to_string(col_of_offset(d.source_code, l.sp.offset))   + ","
        end
        out = out + "\"message\":\"" + json_escape(l.text) + "\""
        out = out + "}"
        if i < d.labels.len() - 1 is out = out + "," end
        i += 1
    end
    out = out + "],"

    out = out + "\"related\":["
    let mut j: int = 0
    while j < d.related.len() is
        out = out + render_json(d.related[j])
        if j < d.related.len() - 1 is out = out + "," end
        j += 1
    end
    out = out + "]"

    out = out + "}"
    return out
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 12. STYL "MARKDOWN" — blok Markdown, np. do komentarza w Pull Requeście
;; ═══════════════════════════════════════════════════════════════════════════

fn render_markdown(d: Diagnostic) -> string is
    let mut out: string = "**" + capitalize(severity_word_en(d.severity)) + "**"
    if d.code != "" is out = out + " `" + d.code + "`" end
    out = out + ": " + d.message + "\n\n"

    if d.source_code != "" && d.labels.len() > 0 is
        out = out + "```\n"

        let mut touched: [int] = []
        for l in d.labels is touched.push(line_of_offset(d.source_code, l.sp.offset)) end
        let mut min_l: int = touched[0]
        let mut max_l: int = touched[0]
        for t in touched is
            if t < min_l is min_l = t end
            if t > max_l is max_l = t end
        end
        min_l = min_l - 1
        max_l = max_l + 1
        if min_l < 1 is min_l = 1 end
        let total: int = line_count(d.source_code)
        if max_l > total is max_l = total end

        let mut ln: int = min_l
        while ln <= max_l is
            out = out + fmt::pad_left(to_string(ln), 4) + " | " + get_line_text(d.source_code, ln) + "\n"
            ln += 1
        end
        out = out + "```\n\n"

        for l in d.labels is
            if l.text != "" is
                let ln2:  int = line_of_offset(d.source_code, l.sp.offset)
                let col2: int = col_of_offset(d.source_code, l.sp.offset)
                out = out + "- linia " + to_string(ln2) + ", kolumna " + to_string(col2) + ": " + l.text + "\n"
            end
        end
        out = out + "\n"
    end

    if d.help != "" is out = out + "> **Pomoc:** " + d.help + "\n\n" end
    if d.note != "" is out = out + "> **Uwaga:** " + d.note + "\n\n" end
    if d.url  != "" is out = out + "[Zobacz dokumentację](" + d.url + ")\n\n" end

    for r in d.related is
        out = out + "---\n" + render_markdown(r)
    end
    return out
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 13. STYL "GITHUB ACTIONS" — adnotacje `::error/::warning/::notice::`
;; ═══════════════════════════════════════════════════════════════════════════

fn gh_command(sev: Severity) -> string is
    return match sev is
        Severity::Error   => "error"
        Severity::Warning => "warning"
        Severity::Advice  => "notice"
    end
end

fn empty_label() -> Label is
    return Label { sp: Span { offset: 0, len: 0 }, text: "", primary: false }
end

fn build_gh_body(d: Diagnostic, l: Label) -> string is
    let mut body: string = d.message
    if l.text != "" is body = body + " (" + l.text + ")" end
    if d.help != "" is body = body + " | pomoc: " + d.help end
    if d.note != "" is body = body + " | uwaga: " + d.note end
    return body
end

fn render_github(d: Diagnostic) -> string is
    let cmd: string = gh_command(d.severity)
    let mut out: string = ""

    if d.source_code != "" && d.labels.len() > 0 is
        for l in d.labels is
            let ln:  int = line_of_offset(d.source_code, l.sp.offset)
            let col: int = col_of_offset(d.source_code, l.sp.offset)
            out = out + "::" + cmd
            if d.source_name != "" is
                out = out + " file=" + d.source_name + ",line=" + to_string(ln) + ",col=" + to_string(col)
            end
            out = out + ",title=" + gh_escape(d.message)
            out = out + "::" + gh_escape(build_gh_body(d, l)) + "\n"
        end
    else is
        out = out + "::" + cmd + " title=" + gh_escape(d.message) + "::" + gh_escape(build_gh_body(d, empty_label())) + "\n"
    end

    for r in d.related is
        out = out + render_github(r)
    end
    return out
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 14. PUBLICZNE API — dispatcher stylów, raportowanie, zbiorcze podsumowania
;; ═══════════════════════════════════════════════════════════════════════════

pub fn render(d: Diagnostic, cfg: Config) -> string is
    return match cfg.style is
        Style::Graphical     => render_graphical(d, cfg.theme)
        Style::Ascii         => render_graphical(d, cfg.theme.with_charset(charset_ascii()))
        Style::Narratable    => render_narratable(d, cfg.theme)
        Style::Minimal       => render_minimal(d, cfg.theme)
        Style::Json          => render_json(d)
        Style::Markdown      => render_markdown(d)
        Style::GithubActions => render_github(d)
    end
end

;; Wypisuje diagnostykę na stdout, z automatycznie dobraną konfiguracją.
pub fn report(d: Diagnostic) is
    write(render(d, config_default()))
end

;; Wypisuje diagnostykę z jawnie podaną konfiguracją (styl + motyw).
pub fn report_with(d: Diagnostic, cfg: Config) is
    write(render(d, cfg))
end

fn exit_code_for(sev: Severity) -> int is
    return match sev is
        Severity::Error   => 1
        Severity::Warning => 0
        Severity::Advice  => 0
    end
end

;; Wypisuje diagnostykę i kończy proces (kod 1 dla błędu, 0 dla reszty).
pub fn die(d: Diagnostic) is
    report(d)
    exit(exit_code_for(d.severity))
end

pub fn die_with(d: Diagnostic, cfg: Config) is
    report_with(d, cfg)
    exit(exit_code_for(d.severity))
end

fn summarize_with(ds: [Diagnostic], pal: Palette) -> string is
    let mut errors:   int = 0
    let mut warnings: int = 0
    let mut advices:  int = 0
    for d in ds is
        match d.severity is
            Severity::Error   => errors   += 1
            Severity::Warning => warnings += 1
            Severity::Advice  => advices  += 1
        end
    end

    let mut parts: [string] = []
    if errors > 0 is
        parts.push(paint(pal.error_c, to_string(errors) + " " + pluralize(errors, "błąd", "błędy", "błędów"), pal))
    end
    if warnings > 0 is
        parts.push(paint(pal.warning_c, to_string(warnings) + " " + pluralize(warnings, "ostrzeżenie", "ostrzeżenia", "ostrzeżeń"), pal))
    end
    if advices > 0 is
        parts.push(paint(pal.advice_c, to_string(advices) + " " + pluralize(advices, "porada", "porady", "porad"), pal))
    end
    if parts.len() == 0 is return "Brak zgłoszonych diagnostyk." end
    return str::join(parts, paint(pal.border_c, ", ", pal))
end

;; Zwraca zdanie podsumowujące listę diagnostyk, np.
;; "2 błędy, 1 ostrzeżenie" (czysty tekst, bez kolorów).
pub fn summarize(ds: [Diagnostic]) -> string is
    return summarize_with(ds, palette_mono())
end

;; To samo, ale pokolorowane paletą z motywu (błędy czerwone, ostrzeżenia
;; żółte, porady cyjan). Dla motywów mono daje czysty tekst.
pub fn summarize_colored(ds: [Diagnostic], theme: Theme) -> string is
    return summarize_with(ds, theme.palette)
end

;; Czy dany styl to widok dla człowieka (a więc może być kolorowy)?
fn style_is_human(s: Style) -> bool is
    return match s is
        Style::Graphical     => true
        Style::Ascii         => true
        Style::Narratable    => true
        Style::Minimal       => true
        Style::Json          => false
        Style::Markdown      => false
        Style::GithubActions => false
    end
end

;; Wypisuje wszystkie diagnostyki, a na końcu jedno zbiorcze podsumowanie
;; (kolorowe w stylach przeznaczonych dla człowieka).
pub fn print_all(ds: [Diagnostic], cfg: Config) is
    for d in ds is
        write(render(d, cfg))
    end
    write("")
    if style_is_human(cfg.style) is
        write(summarize_colored(ds, cfg.theme))
    else is
        write(summarize(ds))
    end
end

;; ═══════════════════════════════════════════════════════════════════════════
;; 15. OUTCOME<T> — lekki, opcjonalny odpowiednik Result<T, Diagnostic>
;;
;;     Biblioteka nie narzuca tego typu — funkcje mogą równie dobrze zwracać
;;     `T?` i korzystać z operatora `?`. Outcome<T> jest wygodny, gdy chcesz
;;     przenieść pełną diagnostykę (a nie tylko `nil`) w wartości zwracanej.
;;
;;     Użycie (we własnej funkcji, z jawnym typem zwracanym):
;;         fn parse(s: string) -> Outcome<int> is
;;             if !s.is_numeric() is
;;                 return Outcome::Failure(nidus::error("nie liczba"))
;;             end
;;             return Outcome::Success(conv::str_to_int(s))
;;         end
;; ═══════════════════════════════════════════════════════════════════════════

enum Outcome<T> is
    Success(T)
    Failure(Diagnostic)
end

