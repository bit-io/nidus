;; ── testy kolorów (0.2.0) ─────────────────────────────────────────────────

fn sample_diag() -> Diagnostic is
    let mut d: Diagnostic = error("nieznana zmienna `c`")
    d = d.with_code("nidus::resolve::unknown_ident")
    d = d.with_source("add.ns", "fn add(a: int, b: int) -> int is\n    return a + c\nend\n")
    d = d.with_label(primary_label(48, 1, "brak takiej zmiennej"))
    d = d.with_label(label(15, 1, "czy chodziło o `b`?"))
    d = d.with_help("sprawdź literówki w `nazwach`")
    d = d.with_url("https://example.com/e")
    return d
end

#[test]
fn test_colors_present_in_dark_theme() is
    let out: string = render(sample_diag(), config_with(Style::Graphical, theme_dark()))
    assert_true(out.contains("\x1b[1;91m"))   ;; kolor błędu
    assert_true(out.contains("\x1b[95m"))     ;; kod błędu / `backticki`
    assert_true(out.contains("\x1b[96m"))     ;; numer linii z etykietą
end

#[test]
fn test_mono_theme_has_no_escape_codes() is
    let styles: [Style] = [Style::Graphical, Style::Ascii, Style::Narratable, Style::Minimal]
    for st in styles is
        let out: string = render(sample_diag(), config_with(st, theme_mono()))
        assert_true(!out.contains("\x1b"))
    end
end

#[test]
fn test_colors_do_not_change_layout() is
    ;; po zdjęciu sekwencji ANSI widok kolorowy == widok bez kolorów
    let colored: string = render(sample_diag(), config_with(Style::Graphical, theme_dark()))
    let plain:   string = render(sample_diag(), config_with(Style::Graphical, theme_mono_unicode()))
    assert_eq(fmt::strip_ansi(colored), plain)

    let colored_min: string = render(sample_diag(), config_with(Style::Minimal, theme_dark()))
    let plain_min:   string = render(sample_diag(), config_with(Style::Minimal, theme_mono()))
    assert_eq(fmt::strip_ansi(colored_min), plain_min)
end

#[test]
fn test_highlight_line() is
    let pal: Palette = palette_dark()
    let placed: [Placed] = [Placed { text: "x", primary: true, col_start: 5, col_end: 8 }]
    let out: string = highlight_line("abcdefghij", placed, pal.error_c, pal)
