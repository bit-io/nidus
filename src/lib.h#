pub let VERSION: string = "0.1.0"

pub fn about() -> string is
    return "nidus v" + VERSION + " -- rozbudowana biblioteka diagnostyczna dla H#, inspirowana miette"
end

;; ── Wrappery API (krótkie nazwy funkcji) ─────────────────────────────────

;; Stałe angielskie słowa (stabilne, używane w JSON / GitHub Actions —
;; formaty maszynowe/parsowalne, które NIE powinny być lokalizowane).
pub fn severity_word_en(sev: nidus_severity::Severity) -> string is
    return nidus_severity::severity_word_en(sev)
end

pub fn span(offset: int, len: int) -> nidus_span::Span is
    return nidus_span::span(offset, len)
end

;; Zakres wskazujący pojedynczy punkt (np. brakujący znak).
pub fn point(offset: int) -> nidus_span::Span is
    return nidus_span::point(offset)
end

pub fn label(offset: int, len: int, text: string) -> nidus_span::Label is
    return nidus_span::label(offset, len, text)
end

pub fn label_at(offset: int, text: string) -> nidus_span::Label is
    return nidus_span::label_at(offset, text)
end

pub fn primary_label(offset: int, len: int, text: string) -> nidus_span::Label is
    return nidus_span::primary_label(offset, len, text)
end

pub fn primary_label_at(offset: int, text: string) -> nidus_span::Label is
    return nidus_span::primary_label_at(offset, text)
end

;; ── Konstruktory ─────────────────────────────────────────────────────────
pub fn diagnostic(message: string) -> nidus_diagnostic::Diagnostic is
    return nidus_diagnostic::diagnostic(message)
end

pub fn error(message: string) -> nidus_diagnostic::Diagnostic is
    return nidus_diagnostic::error(message)
end

pub fn warning(message: string) -> nidus_diagnostic::Diagnostic is
    return nidus_diagnostic::warning(message)
end

pub fn advice(message: string) -> nidus_diagnostic::Diagnostic is
    return nidus_diagnostic::advice(message)
end

pub fn line_count(src: string) -> int is
    return nidus_text::line_count(src)
end

pub fn line_of_offset(src: string, offset: int) -> int is
    return nidus_text::line_of_offset(src, offset)
end

pub fn col_of_offset(src: string, offset: int) -> int is
    return nidus_text::col_of_offset(src, offset)
end

;; Zwraca treść pojedynczej linii (1-based, bez \n / \r).
;; Nieistniejący numer linii zwraca "".
pub fn get_line_text(src: string, line_no: int) -> string is
    return nidus_text::get_line_text(src, line_no)
end

pub fn words_en() -> nidus_theme::Words is
    return nidus_theme::words_en()
end

pub fn words_pl() -> nidus_theme::Words is
    return nidus_theme::words_pl()
end

pub fn theme_dark() -> nidus_theme::Theme is
    return nidus_theme::theme_dark()
end

pub fn theme_light() -> nidus_theme::Theme is
    return nidus_theme::theme_light()
end

;; Bez unikodu (bezpieczne dla starszych terminali), ale wciąż kolorowe.
pub fn theme_ascii() -> nidus_theme::Theme is
    return nidus_theme::theme_ascii()
end

;; Bez kolorów i bez unikodu — najbezpieczniejszy motyw (logi, pliki, CI).
pub fn theme_mono() -> nidus_theme::Theme is
    return nidus_theme::theme_mono()
end

;; Bez kolorów, ale z ładną grafiką unikodową (np. output przekierowany do
;; pliku na terminalu z UTF-8, gdzie kolor jest zbędny, ale znaki nie szkodzą).
pub fn theme_mono_unicode() -> nidus_theme::Theme is
    return nidus_theme::theme_mono_unicode()
end

pub fn theme_retro() -> nidus_theme::Theme is
    return nidus_theme::theme_retro()
end

;; Domyślny ciemny motyw, ale ze wszystkimi napisami po polsku.
pub fn theme_polski() -> nidus_theme::Theme is
    return nidus_theme::theme_polski()
end

pub fn theme_vivid() -> nidus_theme::Theme is
    return nidus_theme::theme_vivid()
end

pub fn theme_nord() -> nidus_theme::Theme is
    return nidus_theme::theme_nord()
end

pub fn theme_dracula() -> nidus_theme::Theme is
    return nidus_theme::theme_dracula()
end

;; Unikod + 256 kolorów (terminale bez truecolor).
pub fn theme_256() -> nidus_theme::Theme is
    return nidus_theme::theme_256()
end

;; Motyw po nazwie ("dark", "light", "vivid", "nord", "dracula", "retro", "256",
;; "polski", "ascii", "mono", "mono_unicode"); nieznana nazwa daje "dark".
pub fn theme_by_name(name: string) -> nidus_theme::Theme is
    return nidus_theme::theme_by_name(name)
end

;; Najładniejszy motyw dla poziomu kolorów (0 brak, 1 = 16, 2 = 256, 3 = truecolor).
pub fn theme_for_level(level: int, unicode: bool) -> nidus_theme::Theme is
    return nidus_theme::theme_for_level(level, unicode)
end

;; Poziom kolorów terminala: 0 brak · 1 = 16 · 2 = 256 · 3 = truecolor.
;; Nadpisanie: NIDUS_COLOR_LEVEL=1|2|3.
pub fn detect_color_level() -> int is
    return nidus_style::detect_color_level()
end

pub fn style_name(s: nidus_style::Style) -> string is
    return nidus_style::style_name(s)
end

pub fn detect_unicode_support() -> bool is
    return nidus_style::detect_unicode_support()
end

;; Kolejność decyzji (od najsilniejszej):
;;  1. NIDUS_COLOR=always|never   -> jawne nadpisanie (np. dla procesu potomnego z pipe)
;;  2. NO_COLOR                   -> bez kolorów (https://no-color.org)
;;  3. CLICOLOR_FORCE / FORCE_COLOR -> kolory wymuszone
;;  4. terminal (TERM, nie "dumb") -> kolory
pub fn detect_color_support() -> bool is
    return nidus_style::detect_color_support()
end

;; Wybiera styl na podstawie środowiska:
;;  - CI GitHub Actions           -> GithubActions
;;  - zmienna NIDUS_STYLE         -> wymuszony styl (ręczne nadpisanie)
;;  - stdout nie jest terminalem  -> Minimal (dobre do logów/grep)
;;  - terminal wspiera UTF-8      -> Graphical
;;  - w przeciwnym razie          -> Ascii
pub fn auto_style() -> nidus_style::Style is
    return nidus_style::auto_style()
end

pub fn auto_theme() -> nidus_theme::Theme is
    return nidus_style::auto_theme()
end

pub fn config_default() -> nidus_style::Config is
    return nidus_style::config_default()
end

pub fn config_with(style: nidus_style::Style, theme: nidus_theme::Theme) -> nidus_style::Config is
    return nidus_style::config_with(style, theme)
end

;; Zawsze kolorowo: pełny widok graficzny z kolorami niezależnie od autodetekcji
;; (unikod, jeśli terminal go deklaruje; w przeciwnym razie ASCII).
pub fn config_colored() -> nidus_style::Config is
    return nidus_style::config_colored()
end

pub fn render(d: nidus_diagnostic::Diagnostic, cfg: nidus_style::Config) -> string is
    return nidus_report::render(d, cfg)
end

;; Wypisuje diagnostykę na stdout, z automatycznie dobraną konfiguracją.
pub fn report(d: nidus_diagnostic::Diagnostic) is
    nidus_report::report(d)
end

;; Wypisuje diagnostykę z jawnie podaną konfiguracją (styl + motyw).
pub fn report_with(d: nidus_diagnostic::Diagnostic, cfg: nidus_style::Config) is
    nidus_report::report_with(d, cfg)
end

;; Wypisuje diagnostykę i kończy proces (kod 1 dla błędu, 0 dla reszty).
pub fn die(d: nidus_diagnostic::Diagnostic) is
    nidus_report::die(d)
end

pub fn die_with(d: nidus_diagnostic::Diagnostic, cfg: nidus_style::Config) is
    nidus_report::die_with(d, cfg)
end

;; Zwraca zdanie podsumowujące listę diagnostyk, np.
;; "2 błędy, 1 ostrzeżenie" (czysty tekst, bez kolorów).
pub fn summarize(ds: [nidus_diagnostic::Diagnostic]) -> string is
    return nidus_report::summarize(ds)
end

;; To samo, ale pokolorowane paletą z motywu (błędy czerwone, ostrzeżenia
;; żółte, porady cyjan). Dla motywów mono daje czysty tekst.
pub fn summarize_colored(ds: [nidus_diagnostic::Diagnostic], theme: nidus_theme::Theme) -> string is
    return nidus_report::summarize_colored(ds, theme)
end

;; Wypisuje wszystkie diagnostyki, a na końcu jedno zbiorcze podsumowanie
;; (kolorowe w stylach przeznaczonych dla człowieka).
pub fn print_all(ds: [nidus_diagnostic::Diagnostic], cfg: nidus_style::Config) is
    nidus_report::print_all(ds, cfg)
end
