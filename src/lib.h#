end

struct Theme is
    pub charset:           Charset
    pub palette:           Palette
    pub words:              Words
    pub context_lines:     int    ;; ile linii kontekstu nad/pod etykietami
    pub wrap_width:        int    ;; szerokość zawijania tekstu pomocy/uwag
    pub show_line_numbers: bool
end

impl Theme is
    fn with_words(self, w: Words) -> Theme is
        self.words = w
        return self
    end

    fn with_charset(self, c: Charset) -> Theme is
        self.charset = c
        return self
    end

    fn with_palette(self, p: Palette) -> Theme is
        self.palette = p
        return self
    end

    fn with_context(self, n: int) -> Theme is
        self.context_lines = n
        return self
    end

    fn with_wrap(self, n: int) -> Theme is
        self.wrap_width = n
        return self
    end
end

