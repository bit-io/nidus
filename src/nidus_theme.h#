;; Motyw po nazwie (dla NIDUS_THEME i konfiguracji). Nieznana nazwa -> dark.
pub fn theme_known(name: string) -> bool is
    return name == "dark" || name == "light" || name == "ascii" || name == "mono" ||
           name == "mono_unicode" || name == "retro" || name == "polski" ||
           name == "vivid" || name == "nord" || name == "dracula" || name == "256"
end

pub fn theme_by_name(name: string) -> Theme is
    if name == "light"        is return theme_light() end
    if name == "ascii"        is return theme_ascii() end
    if name == "mono"         is return theme_mono() end
    if name == "mono_unicode" is return theme_mono_unicode() end
    if name == "retro"        is return theme_retro() end
    if name == "polski"       is return theme_polski() end
    if name == "vivid"        is return theme_vivid() end
    if name == "nord"         is return theme_nord() end
    if name == "dracula"      is return theme_dracula() end
    if name == "256"          is return theme_256() end
    return theme_dark()
end

;; Najładniejszy motyw dla danego poziomu kolorów terminala
;; (0 brak · 1 = 16 · 2 = 256 · 3 = truecolor) i obsługi unikodu.
pub fn theme_for_level(level: int, unicode: bool) -> Theme is
    let mut t: Theme = theme_mono_unicode()
    if level >= 3 is
        t = theme_vivid()
    elsif level == 2 is
        t = theme_256()
    elsif level == 1 is
        t = theme_dark()
    end
    if !unicode is t.charset = charset_ascii() end
    return t
end

;; Domyślny ciemny motyw, ale ze wszystkimi napisami po polsku.
pub fn theme_polski() -> Theme is
    let mut t: Theme = theme_dark()
    t.words = words_pl()
    return t
end

;; Owija tekst kolorem (nic nie robi, gdy kolor pusty — motywy mono).
pub fn paint(color: string, text: string, pal: Palette) -> string is
    if color == "" is return text end
    return color + text + pal.reset
end

;; Koloruje fragmenty w `backtickach` (razem z backtickami). Po zamknięciu
;; fragmentu przywraca styl `after` (np. pogrubienie wiadomości).
;; Niedomknięty backtick -> tekst bez zmian.
pub fn colorize_ticks(text: string, color: string, after: string, pal: Palette) -> string is
    if color == "" is return text end
    let parts: [string] = nstr::split(text, "`")
    if parts.len() % 2 == 0 is return text end
    let mut out: string = ""
    let mut i: int = 0
    while i < parts.len() is
        if i % 2 == 1 is
            out = out + color + "`" + parts[i] + "`" + pal.reset + after
        else is
            out = out + parts[i]
        end
        i += 1
    end
    return out
end

pub fn sev_word_for(sev: nidus_severity::Severity, w: Words) -> string is
    let i: int = nidus_severity::index(sev)
    if i == 0 is return w.error end
    if i == 1 is return w.warning end
    return w.advice
end

pub fn severity_color(sev: nidus_severity::Severity, pal: Palette) -> string is
    let i: int = nidus_severity::index(sev)
    if i == 0 is return pal.error_c end
    if i == 1 is return pal.warning_c end
    return pal.advice_c
end

pub fn severity_icon(sev: nidus_severity::Severity, cs: Charset) -> string is
    let i: int = nidus_severity::index(sev)
    if i == 0 is return cs.icon_error end
    if i == 1 is return cs.icon_warning end
    return cs.icon_advice
end

pub fn label_color(primary: bool, sev_color: string, pal: Palette) -> string is
    if primary is return sev_color end
    return pal.secondary_c
end
