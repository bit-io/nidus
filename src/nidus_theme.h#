;; Słownik lokalizacyjny — pozwala renderować komunikaty w dowolnym języku
;; bez dotykania logiki renderowania.
pub struct Words is
    pub error:     string
    pub warning:   string
    pub advice:    string
    pub help:      string
    pub note:      string
    pub see:       string
    pub caused_by: string
end

pub fn words_en() -> Words is
    return Words {
        error: "error", warning: "warning", advice: "advice",
        help: "help", note: "note", see: "see", caused_by: "caused by"
    }
end

pub fn words_pl() -> Words is
    return Words {
        error: "błąd", warning: "ostrzeżenie", advice: "porada",
        help: "pomoc", note: "uwaga", see: "zobacz",
        caused_by: "spowodowane przez"
    }
end

pub struct Theme is
    pub charset:           Charset
    pub palette:           Palette
    pub words:              Words
    pub context_lines:     int    ;; ile linii kontekstu nad/pod etykietami
    pub wrap_width:        int    ;; szerokość zawijania tekstu pomocy/uwag
    pub show_line_numbers: bool
end

impl Theme is
    fn with_words(self, w: Words) -> Theme is
        self.words = w
        return self
    end

    fn with_charset(self, c: Charset) -> Theme is
        self.charset = c
        return self
    end

    fn with_palette(self, p: Palette) -> Theme is
        self.palette = p
        return self
    end

    fn with_context(self, n: int) -> Theme is
        self.context_lines = n
        return self
    end

    fn with_wrap(self, n: int) -> Theme is
        self.wrap_width = n
        return self
    end
end

pub fn theme_dark() -> Theme is
    return Theme {
        charset: charset_unicode(), palette: palette_dark(), words: words_en(),
        context_lines: 1, wrap_width: 80, show_line_numbers: true
    }
end

pub fn theme_light() -> Theme is
    return Theme {
