;; ── Pomocnicze konstruktory kodów ANSI (0.4.0) ──────────────────────────
;; Truecolor: \x1b[38;2;r;g;bm
pub fn tc(r: int, g: int, b: int) -> string is
    return "\x1b[38;2;" + to_string(r) + ";" + to_string(g) + ";" + to_string(b) + "m"
end

;; Paleta 256 kolorów xterm: \x1b[38;5;nm
pub fn c256(n: int) -> string is
    return "\x1b[38;5;" + to_string(n) + "m"
end

pub fn bold_of(code: string) -> string is
    return "\x1b[1m" + code
end

pub fn underline_of(code: string) -> string is
    return "\x1b[4m" + code
end

