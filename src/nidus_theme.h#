;; Słownik lokalizacyjny — pozwala renderować komunikaty w dowolnym języku
;; bez dotykania logiki renderowania.
pub struct Words is
    pub error:     string
    pub warning:   string
    pub advice:    string
    pub help:      string
    pub note:      string
    pub see:       string
    pub caused_by: string
end

pub fn words_en() -> Words is
    return Words {
        error: "error", warning: "warning", advice: "advice",
        help: "help", note: "note", see: "see", caused_by: "caused by"
    }
end

pub fn words_pl() -> Words is
    return Words {
        error: "błąd", warning: "ostrzeżenie", advice: "porada",
        help: "pomoc", note: "uwaga", see: "zobacz",
        caused_by: "spowodowane przez"
    }
end

pub struct Theme is
    pub charset:           Charset
    pub palette:           Palette
    pub words:              Words
    pub context_lines:     int    ;; ile linii kontekstu nad/pod etykietami
    pub wrap_width:        int    ;; szerokość zawijania tekstu pomocy/uwag
    pub show_line_numbers: bool
end

impl Theme is
    fn with_words(self, w: Words) -> Theme is
        self.words = w
        return self
    end

    fn with_charset(self, c: Charset) -> Theme is
        self.charset = c
        return self
    end

    fn with_palette(self, p: Palette) -> Theme is
        self.palette = p
        return self
    end

    fn with_context(self, n: int) -> Theme is
        self.context_lines = n
        return self
    end

    fn with_wrap(self, n: int) -> Theme is
        self.wrap_width = n
        return self
    end
end

pub fn theme_dark() -> Theme is
    return Theme {
        charset: charset_unicode(), palette: palette_dark(), words: words_en(),
        context_lines: 1, wrap_width: 80, show_line_numbers: true
    }
end

pub fn theme_light() -> Theme is
    return Theme {
        charset: charset_unicode(), palette: palette_light(), words: words_en(),
        context_lines: 1, wrap_width: 80, show_line_numbers: true
    }
end

;; Bez unikodu (bezpieczne dla starszych terminali), ale wciąż kolorowe.
pub fn theme_ascii() -> Theme is
    return Theme {
        charset: charset_ascii(), palette: palette_dark(), words: words_en(),
        context_lines: 1, wrap_width: 80, show_line_numbers: true
    }
end

;; Bez kolorów i bez unikodu — najbezpieczniejszy motyw (logi, pliki, CI).
pub fn theme_mono() -> Theme is
    return Theme {
        charset: charset_ascii(), palette: palette_mono(), words: words_en(),
        context_lines: 1, wrap_width: 80, show_line_numbers: true
    }
end

;; Bez kolorów, ale z ładną grafiką unikodową (np. output przekierowany do
;; pliku na terminalu z UTF-8, gdzie kolor jest zbędny, ale znaki nie szkodzą).
pub fn theme_mono_unicode() -> Theme is
    return Theme {
        charset: charset_unicode(), palette: palette_mono(), words: words_en(),
        context_lines: 1, wrap_width: 80, show_line_numbers: true
    }
end

pub fn theme_retro() -> Theme is
    return Theme {
        charset: charset_unicode(), palette: palette_retro(), words: words_en(),
        context_lines: 2, wrap_width: 80, show_line_numbers: true
    }
end

;; Domyślny ciemny motyw, ale ze wszystkimi napisami po polsku.
pub fn theme_polski() -> Theme is
    let mut t: Theme = theme_dark()
    t.words = words_pl()
    return t
end

;; Owija tekst kolorem (nic nie robi, gdy kolor pusty — motywy mono).
pub fn paint(color: string, text: string, pal: Palette) -> string is
    if color == "" is return text end
    return color + text + pal.reset
end

;; Koloruje fragmenty w `backtickach` (razem z backtickami). Po zamknięciu
;; fragmentu przywraca styl `after` (np. pogrubienie wiadomości).
;; Niedomknięty backtick -> tekst bez zmian.
pub fn colorize_ticks(text: string, color: string, after: string, pal: Palette) -> string is
    if color == "" is return text end
    let parts: [string] = str::split(text, "`")
    if parts.len() % 2 == 0 is return text end
    let mut out: string = ""
    let mut i: int = 0
    while i < parts.len() is
        if i % 2 == 1 is
            out = out + color + "`" + parts[i] + "`" + pal.reset + after
        else is
            out = out + parts[i]
        end
        i += 1
    end
    return out
end

pub fn sev_word_for(sev: nidus_severity::Severity, w: Words) -> string is
    let i: int = nidus_severity::index(sev)
    if i == 0 is return w.error end
    if i == 1 is return w.warning end
    return w.advice
end

pub fn severity_color(sev: nidus_severity::Severity, pal: Palette) -> string is
    let i: int = nidus_severity::index(sev)
    if i == 0 is return pal.error_c end
    if i == 1 is return pal.warning_c end
    return pal.advice_c
end

pub fn severity_icon(sev: nidus_severity::Severity, cs: Charset) -> string is
    let i: int = nidus_severity::index(sev)
    if i == 0 is return cs.icon_error end
    if i == 1 is return cs.icon_warning end
    return cs.icon_advice
end

pub fn label_color(primary: bool, sev_color: string, pal: Palette) -> string is
    if primary is return sev_color end
    return pal.secondary_c
end
