use "std -> strings" from "str"

mod nidus_severity

pub struct Charset is
    pub top_left:        string
    pub h_bar:            string
    pub v_bar:            string
    pub bottom_left:      string
    pub dot:              string
    pub underline:        string
    pub connector:        string
    pub vbar_connector:   string
    pub icon_error:       string
    pub icon_warning:     string
    pub icon_advice:      string
end

pub fn charset_unicode() -> Charset is
    return Charset {
        top_left: "╭", h_bar: "─", v_bar: "│", bottom_left: "╰",
        dot: "·", underline: "─", connector: "╰─▶", vbar_connector: "│",
        icon_error: "×", icon_warning: "⚠", icon_advice: "☞"
    }
end

pub fn charset_ascii() -> Charset is
    return Charset {
        top_left: ",", h_bar: "-", v_bar: "|", bottom_left: "`",
        dot: ":", underline: "^", connector: "`->", vbar_connector: "|",
        icon_error: "x", icon_warning: "!", icon_advice: "i"
    }
end

pub struct Palette is
    pub error_c:     string
    pub warning_c:   string
    pub advice_c:    string
    pub help_c:      string
    pub note_c:      string
    pub link_c:      string
    pub dim_c:       string
    pub bold_c:      string
    pub reset:       string
    ;; --- dodane w 0.2.0: pełne kolorowanie widoku ---
    pub border_c:    string   ;; ramka: ╭─[ │ · ╰────
    pub lineno_c:    string   ;; numery linii (linie z etykietami)
    pub path_c:      string   ;; nazwa pliku w nagłówku fragmentu
    pub pos_c:       string   ;; linia:kolumna
    pub code_c:      string   ;; kod błędu oraz `fragmenty w backtickach`
    pub secondary_c: string   ;; etykiety pomocnicze (nie-główne)
end

