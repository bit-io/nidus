use "bit -> nidus" from "nidus"

fn main() is
    let src: string = "let cfg = load(\"app.toml\")\nlet port = cfg.port\n"

    let mut d: nidus::diagnostic::Diagnostic = nidus::error("brakujący klucz `port` w konfiguracji")
    d = d.with_code("nidus::config::missing_key")
    d = d.with_source("app.toml", src)
    d = d.with_label(nidus::primary_label(42, 4, "ten klucz nie istnieje w pliku app.toml"))
    d = d.with_help("dodaj `port = 8080` do sekcji [server]")
    d = d.with_url("https://example.com/docs/config#port")

    ;; kolorowy motyw — style dla człowieka (graphical/ascii/narratable/minimal) dostają kolory,
    ;; json/markdown/github zawsze są czystym tekstem. Chcesz bez kolorów? nidus::theme_mono()
    let theme: nidus::theme::Theme = nidus::theme_dark()

    write("=== graphical ===")
    nidus::report_with(d, nidus::config_with(nidus::style::graphical(), theme))

    write("=== ascii ===")
    nidus::report_with(d, nidus::config_with(nidus::style::ascii(), theme))

    write("=== narratable ===")
    nidus::report_with(d, nidus::config_with(nidus::style::narratable(), theme))

    write("=== minimal ===")
    nidus::report_with(d, nidus::config_with(nidus::style::minimal(), theme))

    write("=== json ===")
    nidus::report_with(d, nidus::config_with(nidus::style::json(), theme))

    write("=== markdown ===")
    nidus::report_with(d, nidus::config_with(nidus::style::markdown(), theme))

    write("=== github actions ===")
    nidus::report_with(d, nidus::config_with(nidus::style::github_actions(), theme))
end
