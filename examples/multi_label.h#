use "bit -> nidus" from "nidus"

fn main() is
    let src: string = "fn add(a: int, b: int) -> int is\n    return a + c\nend\n"
    ;; "c" (offset 48, len 1) nie istnieje — pokażemy dwie etykiety:
    ;; jedną główną na "c", jedną pomocniczą na deklaracji "b" (offset 15)

    let mut d: nidus::Diagnostic = nidus::error("nieznana zmienna `c`")
    d = d.with_code("nidus::resolve::unknown_ident")
    d = d.with_source("add.ns", src)
    d = d.with_label(nidus::primary_label(48, 1, "brak takiej zmiennej w zasięgu"))
    d = d.with_label(nidus::label(15, 1, "czy chodziło o `b`?"))
    d = d.with_help("sprawdź literówki w nazwach zmiennych")

    nidus::report(d)
end
