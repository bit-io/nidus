[package]
-> name        => nidus
-> version     => 0.1.0
-> description => Rozbudowana biblioteka diagnostyczna dla H#, inspirowana miette — czytelne, konfigurowalne raporty bledow w wielu stylach (graphical, ascii, narratable, minimal, json, markdown, github)
-> author      => Bytes Developers
-> license     => MIT

[build]
-> lang   => h#
-> entry  => src/lib.h#
-> output => build/libnidus
-> emit   => lib

[deps]
