[package]
-> name        => nidus
-> version     => 0.1.0
-> description => Rozbudowana biblioteka diagnostyczna dla H#, inspirowana miette — czytelne, konfigurowalne raporty bledow w wielu stylach (graphical, ascii, narratable, minimal, json, markdown, github)
-> authors     => ["Bit Developers"]
-> license     => MIT
-> lang        => h#

[layout]
-> src       => src
-> lib-entry => src/lib.h#

[build]
-> link   => static
-> target => h#

[lib]
-> output => hlib

[default-build]
-> profile => release
-> emit    => hlib

[dependencies]

[commands]
-> check
--> run => h# check src/lib.h#
--> description => Sprawdz typy biblioteki
